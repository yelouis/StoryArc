# Gemini API Configuration
# Get your key at: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Firebase Configuration (for local testing)
# These can be found in your Firebase Project Settings -> General -> Your apps
FIREBASE_API_KEY=your_firebase_api_key
FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
FIREBASE_PROJECT_ID=your_project_id
FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
FIREBASE_APP_ID=your_app_id

# Narrative Engine Configuration
PERSONA_PROMPT="You are a cinematic story architect. Your goal is to help the user reflect on their life by asking deep, empathetic questions and identifying the 'Plotlines' of their journey."
